# gemini or anthropic
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=your-model-id
PORT=8787

# Free key from https://fdc.nal.usda.gov/api-key-signup.html (DEMO_KEY works but is limited to ~30 requests/hour)
USDA_API_KEY=DEMO_KEY
# Set to off to disable USDA grounding
GROUNDING=on

# Fallback chain: tried in order when the main provider is busy, over quota or failing.
# Providers without a key are skipped. Get a free Groq key at https://console.groq.com/keys
AI_FALLBACKS=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Optional architecture switches (defaults are native/classic)
# LLM_LAYER=langchain     -> LangChain chat models + withFallbacks instead of the hand-written adapters
# COACH_ENGINE=langgraph  -> LangGraph agent with native tool calling and interrupt-based client tools
LLM_LAYER=langchain
COACH_ENGINE=langgraph

# ---- Google sign-in + sync (optional; see SETUP-FIREBASE.md) ----
# Web app config from Firebase console -> Project settings -> Your apps -> Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Server: set to require sign-in on the AI endpoints (same project id as above)
FIREBASE_PROJECT_ID=
# Optional: only these Google accounts may use the server (comma separated)
ALLOWED_EMAILS=
# Optional: AI requests per user per minute
RATE_LIMIT_PER_MIN=60

# ---- Daily AI limits (apply to signed-in users; see server/usage.mjs) ----
# AI actions per person per day (logging = 1, meal plan = 2, coach question = 2). 0 = unlimited.
DAILY_AI_LIMIT=40
# Optional: spend cap across all users; when reached, AI pauses for the day. 0 = off.
GLOBAL_DAILY_AI_LIMIT=0
# Optional: accounts exempt from the per-person limit (comma separated).
UNLIMITED_EMAILS=
# The day rolls over at midnight in this IANA time zone.
QUOTA_TIMEZONE=Asia/Kolkata
