{
  "expo": {
    "name": "Munch",
    "slug": "journable-local",
    "scheme": "journable",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mihir.journablelocal"
    },
    "android": {
      "package": "com.mihir.journablelocal",
      "adaptiveIcon": {
        "backgroundImage": "./assets/android-icon-background.png",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#f6f6fa",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#09090c"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Munch uses your photos so the AI can estimate what you ate.",
          "cameraPermission": "Munch uses the camera so the AI can estimate what you ate."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-status-bar",
      "expo-secure-store",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "MunchCalories",
              "label": "Munch · Calories left",
              "description": "Calories left today and your progress",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "previewImage": "./assets/widget-preview/calories.png",
              "resizeMode": "none",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "MunchToday",
              "label": "Munch · Today",
              "description": "Calories left plus protein, carbs and fat",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "previewImage": "./assets/widget-preview/today.png",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "MunchQuickLog",
              "label": "Munch · Quick log",
              "description": "Tap to log what you ate",
              "minWidth": "250dp",
              "minHeight": "55dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "previewImage": "./assets/widget-preview/quicklog.png",
              "resizeMode": "horizontal",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e8e73aea-67af-495d-98ad-cf0b746ea3c1"
      }
    },
    "owner": "mihir.b"
  }
}
