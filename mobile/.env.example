# Google sign-in + sync for the phone app (optional). Copy to mobile/.env and fill in.
# Leave empty to keep the app local-only (it works in Expo Go that way).
# These are public identifiers (not secrets). Same Firebase project as the web app.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# OAuth client of type "Web application" (Firebase creates one automatically when you enable Google sign-in)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
